{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u65b0\u52a0\u5761\u5357\u6d0b\u7406\u5de5\u5b66\u9662\u6bd5\u4e1a\u8bc1\uff08Nanyang Polytechnic diploma) \u6837\u672c\u4e0e\u542b\u91d1\u91cf\u5168\u89e3\u6790","text":"<p>\u5728\u5f53\u4eca\u5168\u7403\u5316\u7684\u4eba\u624d\u5e02\u573a\u4e2d\uff0c\u65b0\u52a0\u5761\u7684\u6559\u80b2\u4f53\u7cfb\u51ed\u501f\u5176\u4e25\u8c28\u3001\u5b9e\u7528\u4e0e\u56fd\u9645\u5316\u7684\u7279\u5f81\u5907\u53d7\u77a9\u76ee\u3002\u4f5c\u4e3a\u65b0\u52a0\u5761\u4e94\u6240\u653f\u5e9c\u516c\u7acb\u7406\u5de5\u5b66\u9662\u4e4b\u4e00\uff0c\u65b0\u52a0\u5761\u5357\u6d0b\u7406\u5de5\u5b66\u9662\uff08Nanyang Polytechnic\uff0c\u7b80\u79f0 NYP\uff09 \u6bd5\u4e1a\u8bc1\uff08Nanyang Polytechnic diploma\uff09\u5728\u56fd\u9645\u5c31\u4e1a\u5e02\u573a\u548c\u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\u5747\u4eab\u6709\u6781\u9ad8\u7684\u8ba4\u53ef\u5ea6\u3002</p> <p></p> <p>\u672c\u6587\u5c06\u7ed3\u5408\u6700\u65b0\u641c\u96c6\u7684\u771f\u5b9e\u6848\u4f8b\uff08\u59822024\u5e743\u6708\u4efd\u9881\u53d1\u7684 Diploma in Mass Media Management \u5927\u4f17\u4f20\u5a92\u7ba1\u7406\u6587\u51ed\u6837\u672c\uff09\uff0c\u6df1\u5ea6\u4e3a\u60a8\u62c6\u89e3 NYP \u6bd5\u4e1a\u8bc1\u7684\u6838\u5fc3\u542b\u91d1\u91cf\u3001\u5916\u89c2\u9632\u4f2a\u7279\u5f81\uff0c\u4ee5\u53ca\u6bd5\u4e1a\u540e\u7684\u5347\u5b66\u4e0e\u5c31\u4e1a\u524d\u666f\u3002</p>"},{"location":"#nyp-diploma","title":"\ud83d\udd0d \u65b0\u52a0\u5761\u5357\u6d0b\u7406\u5de5\u5b66\u9662\u6bd5\u4e1a\u8bc1\u6837\u672c\u957f\u4ec0\u4e48\u6837\uff1f\uff08NYP Diploma \u5916\u89c2\u9632\u4f2a\u7279\u5f81\uff09","text":"<p>\u5bf9\u4e8e\u8bb8\u591a\u8ba1\u5212\u7559\u5b66\u6216\u9700\u8981\u8fdb\u884c\u5b66\u5386\u8ba4\u8bc1\u7684\u540c\u5b66\u6765\u8bf4\uff0c\u4e86\u89e3\u771f\u5b9e\u7684\u6bd5\u4e1a\u8bc1\u5916\u89c2\u81f3\u5173\u91cd\u8981\u3002\u6839\u636e\u65b0\u52a0\u5761\u5357\u6d0b\u7406\u5de5\u5b66\u9662\u6700\u65b0\u9881\u53d1\u7684\u5b98\u65b9\u6587\u51ed\uff0c\u5176\u7eb8\u8d28\u7248\u6bd5\u4e1a\u8bc1\u5177\u6709\u6781\u9ad8\u8fa8\u8bc6\u5ea6\u7684\u6392\u7248\u4e0e\u9632\u4f2a\u5de5\u827a\uff1a</p> <ol> <li>\u5de6\u4e0a\u89d2\u5b98\u65b9\u6807\u5fd7\uff08Logo\uff09\uff1a    \u4e0a\u65b9\u5370\u6709\u9192\u76ee\u7684 NYP \u53e0\u5f69\u6e10\u53d8\u6807\u5fd7\uff0c\u4e0b\u65b9\u914d\u6709\u6807\u51c6\u82f1\u6587\u5b57\u4f53 <code>NANYANG POLYTECHINC</code>\u3002</li> <li>\u5de6\u4e0b\u89d2\u706b\u6f06\u611f\u94a2\u5370\uff08Seal\uff09\uff1a    \u5de6\u4e0b\u89d2\u538b\u5370\u6709\u4e00\u679a\u6a59\u7ea2\u8272\u7684\u9f7f\u8f6e\u72b6\u5706\u5f62\u5b98\u65b9\u94a2\u5370\uff0c\u4e2d\u95f4\u6e05\u6670\u5e26\u6709\u201cNYP\u201d\u51f9\u51f8\u5b57\u6837\uff0c\u8fd9\u662f\u9632\u4f2a\u4e0e\u786e\u6743\u7684\u6838\u5fc3\u89c6\u89c9\u6807\u5fd7\u3002</li> <li>\u6b63\u6587\u4e66\u6cd5\u4e0e\u6392\u7248\uff1a    \u6b63\u6587\u91c7\u7528\u6781\u5177\u73b0\u4ee3\u611f\u7684\u65e0\u886c\u7ebf\u5b57\u4f53\uff0c\u6838\u5fc3\u6587\u51ed\u540d\u79f0\uff08\u4f8b\u5982\uff1aDiploma in Mass Media Management\uff09\u901a\u5e38\u4f1a\u52a0\u7c97\u653e\u5927\u663e\u793a\u3002</li> <li>\u6821\u65b9\u9886\u5bfc\u4eba\u7b7e\u540d\uff1a    \u8bc1\u4e66\u5e95\u90e8\u6574\u9f50\u6392\u5217\u7740\u4e09\u4f4d\u6838\u5fc3\u8d1f\u8d23\u4eba\u7684\u624b\u5199\u4f53\u7b7e\u540d\u53ca\u5370\u5237\u804c\u4f4d\uff0c\u5206\u522b\u662f\uff1a</li> <li>Chairman (\u8463\u4e8b\u4f1a\u4e3b\u5e2d)</li> <li>Principal &amp; CEO (\u6821\u957f\u517c\u9996\u5e2d\u6267\u884c\u5b98)</li> <li>Registrar (\u6559\u52a1\u957f)</li> <li>\u5e95\u90e8\u6821\u540d\u6807\u6ce8\uff1a    \u6b63\u4e0b\u65b9\u4f1a\u7528\u7070\u8272\u5fae\u7f29\u5b57\u4f53\u6e05\u6670\u6807\u6ce8 <code>NANYANG POLYTECHNIC, SINGAPORE</code>\u3002</li> </ol>"},{"location":"#nyp","title":"\ud83d\udcc8 \u4e3a\u4ec0\u4e48\u65b0\u52a0\u5761NYP\u6587\u51ed\u5728\u56fd\u5185\u5916\u5982\u6b64\u62a2\u624b\uff1f","text":""},{"location":"#1","title":"1. \u4e2d\u56fd\u6559\u80b2\u90e8\u5168\u9762\u8ba4\u53ef\uff0c\u7559\u670d\u8ba4\u8bc1\u65e0\u7f1d\u5bf9\u63a5","text":"<p>\u65b0\u52a0\u5761\u5357\u6d0b\u7406\u5de5\u5b66\u9662\u4f5c\u4e3a\u65b0\u52a0\u5761\u653f\u5e9c\u6240\u5c5e\u7684\u516c\u7acb\u9ad8\u7b49\u5b66\u5e9c\uff0c\u5176\u9881\u53d1\u7684 Diploma\uff08\u5927\u4e13\u6587\u51ed/\u9ad8\u7ea7\u6587\u51ed\uff09\u5c5e\u4e8e\u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\u5b8c\u5168\u8ba4\u53ef\u7684\u5883\u5916\u5b66\u5386\u8303\u7574\u3002\u6bd5\u4e1a\u56de\u56fd\u540e\uff0c\u5b66\u751f\u53ef\u4ee5\u987a\u7545\u529e\u7406\u7559\u670d\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\uff0c\u4eab\u53d7\u6d77\u5916\u7559\u5b66\u751f\u843d\u6237\u3001\u56fd\u5185\u4f01\u4e8b\u4e1a\u5355\u4f4d\u62a5\u8003\u7b49\u4e00\u7cfb\u5217\u4f18\u60e0\u653f\u7b56\u3002</p>"},{"location":"#2-tuition-grant","title":"2. \u65b0\u52a0\u5761\u653f\u5e9c\u9ad8\u989d\u52a9\u5b66\u91d1\uff08Tuition Grant\uff09","text":"<p>\u5165\u8bfb NYP \u7684\u56fd\u9645\u5b66\u751f\u901a\u5e38\u6709\u673a\u4f1a\u7533\u8bf7\u7531\u65b0\u52a0\u5761\u653f\u5e9c\u63d0\u4f9b\u7684\u5b66\u8d39\u51cf\u514d\u52a9\u5b66\u91d1\u3002\u83b7\u5f97\u6b64\u9879\u52a9\u5b66\u91d1\u7684\u5b66\u751f\uff0c\u5b66\u8d39\u80fd\u591f\u5f97\u5230\u5927\u5e45\u5ea6\u51cf\u514d\uff0c\u4f46\u4f5c\u4e3a\u56de\u62a5\uff0c\u5b66\u751f\u9700\u4e0e\u65b0\u52a0\u5761\u653f\u5e9c\u7b7e\u7f72\u5408\u7ea6\uff0c\u627f\u8bfa\u6bd5\u4e1a\u540e\u5728\u65b0\u52a0\u5761\u6ce8\u518c\u7684\u516c\u53f8\u5de5\u4f5c\u4e09\u5e74\u3002\u8fd9\u76f4\u63a5\u4e3a\u6bd5\u4e1a\u751f\u94fa\u5e73\u4e86\u5728\u65b0\u52a0\u5761\u7684\u5c31\u4e1a\u4e0e\u79fb\u6c11\u4e4b\u8def\u3002</p>"},{"location":"#nanyang-polytechnic-diploma_1","title":"\ud83d\udca1 \u70ed\u95e8\u641c\u7d22\uff1a\u6301\u6709 Nanyang Polytechnic Diploma \u540e\u7684\u53d1\u5c55\u51fa\u8def","text":"<p>\u4e0d\u5c11\u4eba\u5728\u8c37\u6b4c\u548c\u767e\u5ea6\u4e0a\u9891\u9891\u641c\u7d22\uff1a\u201c\u65b0\u52a0\u5761\u7406\u5de5\u5b66\u9662\u6bd5\u4e1a\u597d\u5347\u5927\u5b66\u5417\uff1f\u201d \u6216\u8005 \u201cNYP\u6bd5\u4e1a\u5728\u65b0\u52a0\u5761\u85aa\u8d44\u591a\u5c11\uff1f\u201d\u3002\u5176\u5b9e\uff0c\u62ff\u5230\u8fd9\u5757\u8df3\u677f\u540e\uff0c\u53d1\u5c55\u65b9\u5411\u4e3b\u8981\u5206\u4e3a\u4e24\u6761\u542b\u91d1\u91cf\u6781\u9ad8\u7684\u8def\u7ebf\uff1a</p>"},{"location":"#_1","title":"\ud83d\udd04 \u8def\u7ebf\u4e00\uff1a\u76f4\u5347\u65b0\u52a0\u5761\u516c\u7acb\u5927\u5b66\u6216\u6d77\u5916\u540d\u6821\uff08\u9ad8\u7ea7\u8df3\u677f\uff09","text":"<p>\u4f18\u79c0\u7684 NYP \u6bd5\u4e1a\u751f\u51ed\u501f\u5728\u6821\u7684 GPA \u6210\u7ee9\uff0c\u53ef\u4ee5\u514d\u8bd5\u76f4\u63a5\u7533\u8bf7\u65b0\u52a0\u5761\u672c\u5730\u7684\u9876\u7ea7\u516c\u7acb\u5927\u5b66\uff1a * \u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66 (NUS) * \u5357\u6d0b\u7406\u5de5\u5927\u5b66 (NTU) * \u65b0\u52a0\u5761\u7ba1\u7406\u5927\u5b66 (SMU)</p> <p>\u6b64\u5916\uff0c\u7531\u4e8e\u65b0\u52a0\u5761\u7684\u7406\u5de5\u5b66\u9662\u8bfe\u7a0b\u4e0e\u82f1\u8054\u90a6\u6559\u80b2\u4f53\u5236\u9ad8\u5ea6\u63a5\u8f68\uff0c\u6bd5\u4e1a\u751f\u8fd8\u53ef\u4ee5\u76f4\u63a5\u7533\u8bf7\u82f1\u56fd\u3001\u6fb3\u6d32\u7b49\u56fd\u77e5\u540d\u5927\u5b66\u7684\u672c\u79d1\uff0c\u901a\u5e38\u80fd\u591f\u76f4\u63a5\u8c41\u514d1-1.5\u5e74\u7684\u5b66\u5206\uff0c\u7528\u66f4\u77ed\u7684\u65f6\u95f4\u62ff\u5230\u540d\u6821\u5b66\u58eb\u5b66\u4f4d\u3002</p>"},{"location":"#_2","title":"\ud83d\udcbc \u8def\u7ebf\u4e8c\uff1a\u9ad8\u5c31\u4e1a\u7387\u4e0e\u8d77\u85aa\u4fdd\u969c","text":"<p>\u65b0\u52a0\u5761\u7406\u5de5\u5b66\u9662\u7684\u8bfe\u7a0b\u8bbe\u7f6e\u5b8c\u5168\u662f\u4ee5\u5e02\u573a\u548c\u4f01\u4e1a\u9700\u6c42\u4e3a\u5bfc\u5411\u7684\uff08\u5373\u201c\u6559\u5b66\u5de5\u5382\u201d\u7406\u5ff5\uff09\u3002\u4f8b\u5982\u5728\u5168\u5a92\u4f53\u65f6\u4ee3\uff0c\u5176\u5927\u4f17\u4f20\u5a92\u7ba1\u7406\u6587\u51ed\uff08Diploma in Mass Media Management\uff09\u6781\u53d7\u5404\u59274A\u5e7f\u544a\u516c\u53f8\u3001\u65b0\u52a0\u5761\u65b0\u4f20\u5a92\uff08Mediacorp\uff09\u53ca\u5404\u7c7b\u4e92\u8054\u7f51\u8de8\u56fd\u4f01\u4e1a\u7684\u9752\u7750\u3002\u6bd5\u4e1a\u751f\u5728\u79bb\u6821\u524d\u5f80\u5f80\u5c31\u5df2\u62ff\u5230\u591a\u5bb6\u4f01\u4e1a\u7684\u5f55\u53d6\u901a\u77e5\u901a\u77e5\u4e66\uff08Offer\uff09\uff0c\u8d77\u85aa\u5728\u672c\u5730\u5927\u4e13\u5b66\u5386\u4e2d\u540d\u5217\u524d\u8305\u3002</p>"},{"location":"#_3","title":"\ud83d\udee0 \u907f\u5751\u6307\u5357\uff1a\u5982\u4f55\u786e\u4fdd\u5b66\u5386\u6587\u4ef6\u5408\u89c4\u4e0e\u5b89\u5168\uff1f","text":"<p>\u968f\u7740\u6570\u5b57\u5316\u65f6\u4ee3\u7684\u5230\u6765\uff0c\u65b0\u52a0\u5761\u653f\u5e9c\u5df2\u5168\u9762\u63a8\u884c OpenCerts \u6570\u5b57\u5316\u533a\u5757\u94fe\u6587\u51ed\u7cfb\u7edf\u3002\u6240\u6709\u7684 NYP \u6bd5\u4e1a\u751f\u9664\u4e86\u80fd\u62ff\u5230\u7eb8\u8d28\u7248\u6bd5\u4e1a\u8bc1\u5916\uff0c\u8fd8\u4f1a\u5728\u4e2a\u4eba SkillsFuture \u8d26\u6237\u4e2d\u6536\u5230\u4e00\u4efd\u5e26\u6709\u70b9\u5bf9\u70b9\u52a0\u5bc6\u6280\u672f\u7684\u6570\u5b57\u8bc1\u4e66\u3002</p> <ul> <li>\u5207\u52ff\u8f7b\u4fe1\u9ed1\u4ea7\uff1a \u4e92\u8054\u7f51\u4e0a\u5b58\u5728\u8bf8\u5982\u201c\u5feb\u901f\u529e\u7406NYP\u6bd5\u4e1a\u8bc1\u201d\u7684\u865a\u5047\u5e7f\u544a\uff0c\u6b64\u7c7b\u4f2a\u9020\u8bc1\u4e66\u65e0\u6cd5\u901a\u8fc7\u4e2d\u56fd\u7559\u670d\u4e2d\u5fc3\u7684\u7cfb\u7edf\u6838\u9a8c\uff0c\u66f4\u65e0\u6cd5\u901a\u8fc7\u65b0\u52a0\u5761\u4eba\u529b\u90e8\uff08MOM\uff09\u7684\u5de5\u4f5c\u7b7e\u8bc1\uff08SP/EP\uff09\u80cc\u666f\u8c03\u67e5\u3002</li> <li>\u59a5\u5584\u4fdd\u7ba1\u539f\u4ef6\uff1a \u7eb8\u8d28\u8bc1\u4e66\u7684\u7ea2\u5370\u53ca\u7279\u79cd\u7eb8\u8d28\u611f\u5728\u7533\u8bf7\u7ebf\u4e0b\u6750\u6599\u5ba1\u6838\u65f6\u975e\u5e38\u5173\u952e\u3002\u5982\u679c\u56e0\u4e2a\u4eba\u539f\u56e0\u9057\u5931\uff0c\u9700\u8981\u53ca\u65f6\u5411\u5357\u6d0b\u7406\u5de5\u5b66\u9662\u6559\u52a1\u5904\uff08Registrar's Office\uff09\u7533\u8bf7\u5f00\u5177\u5b98\u65b9\u8bc1\u660e\u4e66\uff08Statement of Academic Record\uff09\u3002</li> </ul>"},{"location":"#_4","title":"\ud83d\udcdd \u603b\u7ed3","text":"<p>\u65b0\u52a0\u5761\u5357\u6d0b\u7406\u5de5\u5b66\u9662\u6bd5\u4e1a\u8bc1\uff08Nanyang Polytechnic diploma\uff09\u4e0d\u4ec5\u662f\u4e00\u5f20\u4ee3\u8868\u5b66\u672f\u5408\u683c\u7684\u7eb8\u5f20\uff0c\u66f4\u662f\u901a\u5f80\u56fd\u9645\u5316\u804c\u4e1a\u751f\u6daf\u6216\u4e16\u754c\u9876\u5c16\u6df1\u9020\u5b66\u5e9c\u7684\u9ec4\u91d1\u901a\u884c\u8bc1\u3002\u65e0\u8bba\u60a8\u662f\u5728\u89c4\u5212\u7559\u5b66\u8def\u9014\uff0c\u8fd8\u662f\u6b63\u5904\u4e8e\u6bd5\u4e1a\u8ba4\u8bc1\u9636\u6bb5\uff0c\u4e86\u89e3\u5176\u6587\u51ed\u7279\u5f81\u53ca\u80cc\u540e\u7684\u5347\u5b66\u5c31\u4e1a\u542b\u91d1\u91cf\uff0c\u90fd\u80fd\u5e2e\u52a9\u60a8\u66f4\u597d\u5730\u5229\u7528\u8fd9\u4e00\u4f18\u8d28\u6559\u80b2\u8d44\u6e90\u3002</p> <p>\ud83d\udccc \u5b66\u672f\u6587\u732e\u6536\u5f55\u63d0\u793a\uff1a \u672c\u7bc7\u5173\u4e8e\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66\uff08NUS\uff09\u6587\u51ed\u6392\u7248\u4e0e\u9632\u4f2a\u7279\u5f81\u7684\u56fe\u6587\u89e3\u6790\uff0c\u5df2\u6b63\u5f0f\u5f52\u6863\u81f3 \u3010\u65b0\u52a0\u5761\u5927\u5b66\u5b66\u4f4d\u8bc1\u4e66\u8bbe\u8ba1\u8d4f\u6790\u4e0e\u5b98\u65b9\u9632\u4f2a\u6837\u672c\u6570\u636e\u5e93\u3011\u3002\u5982\u9700\u4e86\u89e3\u5168\u7403\u5176\u4ed6\u540d\u6821\u5de5\u827a\uff0c\u8bf7\u53c2\u9605\u603b\u5e93\u3002</p>"}]}